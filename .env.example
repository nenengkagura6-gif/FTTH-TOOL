# Environment Configuration

# Server Configuration
PORT=8000
DEBUG=false

# CORS Settings
# Origin TAMBAHAN di luar allowlist bawaan di app/main.py, dipisah koma.
# JANGAN pakai "*" — digabung allow_credentials=True itu dilarang spesifikasi
# CORS dan membatalkan proteksi same-origin.
ALLOWED_ORIGINS=

# Endpoint /debug-logs hanya aktif bila token ini di-set DAN cocok dengan
# query ?token=... Biarkan kosong di produksi agar endpoint mengembalikan 404.
DEBUG_LOGS_TOKEN=

# Shared secret untuk POST /api/v1/maintenance/cleanup (hapus file
# kedaluwarsa). Kosongkan = endpoint mati (503). Jadwalkan sekali sehari
# dengan penjadwal gratis: GitHub Actions, cron-job.org, dsb.
MAINTENANCE_TOKEN=

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# Upload Settings
MAX_UPLOAD_SIZE=52428800  # 50MB in bytes
MAX_FILES_PER_REQUEST=10

# Geocoding Settings
NOMINATIM_TIMEOUT=30
NOMINATIM_DELAY=1.2
NOMINATIM_USER_AGENT="KML_Processing_API"

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Observability (opsional — kosongkan kalau tidak dipakai)
# Tanpa DSN, Sentry tidak aktif sama sekali.
SENTRY_DSN_PYTHON=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1
